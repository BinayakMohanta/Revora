# Revora environment configuration
# Copy this file to server/.env to customize. All values are OPTIONAL.
# The app runs fully in DEMO MODE with zero configuration.

# --- Server ---
PORT=5000

# --- Razorpay (optional) ---
# If both are provided, Revora switches to RAZORPAY TEST MODE and uses the
# real Razorpay Test API for Payment Links / Payment / Order lookups.
# Leave blank to stay in DEMO MODE with realistic mocked responses.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI Provider (optional) ---
# AI_PROVIDER can be: demo | openai | anthropic
# "demo" uses Revora's built-in deterministic recovery agent — no key needed.
AI_PROVIDER=demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
